---
import Base from './Base.astro';
import { brief } from '../lib/brief';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<Base title={`${title} · ${brief.name}`} description={`${title} du site ${brief.name}.`}>
  <main class="legal">
    <a href="/" class="legal-back">← {brief.name}</a>
    <article><slot /></article>
  </main>
</Base>
<style>
  .legal { max-width: 68ch; margin: 0 auto; padding: 3rem 1.25rem 5rem; line-height: 1.65; }
  .legal-back { display: inline-block; margin-bottom: 2rem; color: inherit; opacity: 0.7; text-decoration: none; }
  .legal :global(h1) { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 1.5rem; }
  .legal :global(h2) { font-size: 1.15rem; margin: 2.25rem 0 0.5rem; }
  .legal :global(p) { margin: 0.4rem 0; }
</style>
