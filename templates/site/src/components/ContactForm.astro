---
// Le message part vers placeHolder, qui le transmet par email au client (sous-traitant mentionné dans la politique de confidentialité).
import { brief } from '../lib/brief';
const endpoint = brief.forms?.endpoint;
const siteKey = brief.forms?.turnstileSiteKey;
---
{endpoint ? (
  <form class="ph-contact" method="post" action={endpoint} data-ph-form>
    <label>Nom<input name="name" autocomplete="name" required maxlength="120" /></label>
    <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
    <label>Téléphone<input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
    <label>Message<textarea name="message" rows="5" required maxlength="4000"></textarea></label>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="ph-hp" aria-hidden="true" />
    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>}
    <p class="ph-consent">Vos informations servent uniquement à vous répondre. <a href="/confidentialite">Confidentialité</a></p>
    <button type="submit">Envoyer</button>
    <p class="ph-status" role="status" aria-live="polite"></p>
  </form>
) : (
  <p><a href={brief.contact.phone ? `tel:${brief.contact.phone.replace(/[^\d+]/g, '')}` : `mailto:${brief.contact.email ?? ''}`}>Nous contacter</a></p>
)}
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-ph-form]')) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.ph-status')!;
      const button = form.querySelector('button')!;
      button.disabled = true;
      status.textContent = 'Envoi…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        status.textContent = res.ok ? 'Message envoyé. Réponse rapide.' : 'Envoi impossible. Appelez-nous directement.';
        if (res.ok) form.reset();
      } catch {
        status.textContent = 'Envoi impossible. Appelez-nous directement.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
<style>
  .ph-hp { position: absolute; left: -9999px; }
</style>
